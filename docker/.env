# Every version in the stack, in one place, with the reason it is this value.
# The dependency chain runs backwards from the Unity Catalog Spark connector:
# it is the most constrained component, so it dictates Spark, Scala and Delta.
# Taking "latest" for any of these breaks the one below it. See
# docs/adr/0003-version-matrix-for-the-local-lakehouse-stack.md.

# Base image. Scala 2.13 because the UC connector only publishes _2.13.
# Spark 4.0.0 because unitycatalog-spark_2.13:0.4.1 compiles against
# spark-sql_2.13:4.0.0. Not 4.1.x.
SPARK_IMAGE=apache/spark:4.0.0-scala2.13-java17-python3-ubuntu
SPARK_VERSION=4.0.0
SCALA_VERSION=2.13

# Pinned by the UC connector's POM. The latest Delta is 4.3.1, which compiles
# against Spark 4.1.0 and would force a Spark upgrade the connector cannot take.
DELTA_VERSION=4.1.0
DELTA_ARTIFACT=delta-spark_4.0_2.13

# Latest published connector.
UC_CONNECTOR_VERSION=0.4.1
# Pinned like everything else in this file. :latest was the one floating
# tag in the matrix (review-06 M-07); every ADR 0004/0005 finding was
# reproduced against this release, so this is the release we ship.
UC_SERVER_IMAGE=unitycatalog/unitycatalog:v0.5.0

# Must equal the Hadoop bundled in SPARK_IMAGE (3.4.1), not the newest release
# (3.5.0), and not the 3.4.2 the connector was compiled against. The runtime
# Hadoop on the classpath is what hadoop-aws has to match; a mismatch here is
# the classic unhelpful NoSuchMethodError.
HADOOP_VERSION=3.4.1

# Resolved from hadoop-project-3.4.1.pom, property aws-java-sdk-v2.version.
# Hadoop 3.4.x uses AWS SDK v2, not the v1 aws-java-sdk-bundle.
AWS_SDK_VERSION=2.24.6

# Pinned release, not :latest, so the demo is reproducible.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
POSTGRES_IMAGE=postgres:16

# Local-only credentials, deliberately committed. They are demo values for a
# stack that binds to localhost, they appear in the runbook and in
# docker/hive/core-site.xml, and treating them as secrets would mean the
# version matrix above could not live in the repo. Nothing here is reusable
# anywhere real. Real deployments vend credentials; see ADR 0004 for why Unity
# Catalog cannot vend them to MinIO today.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse123
# Renaming this requires rebuilding the Spark image: spark-defaults.conf
# bakes s3a://lakehouse/warehouse at build time (review-06 M-09). The
# metastore and Python derive from this variable; Spark's conf cannot.
LAKEHOUSE_BUCKET=lakehouse

# Hive Metastore. Spark 4.0.0 bundles the Hive 2.3.10 *client*; this is the
# *server*. The thrift API is backwards compatible for the metastore
# operations this platform uses, which is verified by the phase 02 smoke test
# rather than assumed. See ADR 0005.
HIVE_IMAGE=apache/hive:4.0.1
POSTGRES_JDBC_VERSION=42.7.4
